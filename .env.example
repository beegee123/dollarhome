# Copy this file to .env.local and fill in the values.
# Use the same two values as Pantry's .env.local (same Supabase project).
# .env.local is ignored by git, so your values are never committed.
#
# Use the PUBLISHABLE (or "anon") key only — never the secret / service_role key.
# After changing .env.local, stop and restart `npm run dev`.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
